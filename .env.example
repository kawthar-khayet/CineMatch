# Jeton TMDB : "API Read Access Token" sur https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Stockage objet compatible S3 (data lake local) : identifiant et mot de passe (8 caractères minimum)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Adresse de l'API S3 : http://localhost:9000 depuis votre PC, http://object-storage:9000 depuis un conteneur
S3_ENDPOINT=
LAKEHOUSE_BUCKET=

# Postgres (entrepôt de données, couche Gold) : localhost:5433 depuis votre PC, postgres:5432 depuis un conteneur
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# dbt : emplacement du projet et du profil de connexion (chemins relatifs à la racine du projet)
DBT_PROJECT_DIR=
DBT_PROFILES_DIR=

# Airflow : orchestration (interface sur http://localhost:8080)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Clé secrète qui signe les échanges entre les composants d'Airflow. Pour en générer une :
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
